{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t4tmix-recipient",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],

  // The static front-end (index.html, app.js, style.css, shell SVGs, Kalam fonts)
  // is served from ./public via the ASSETS binding — same repo, same deploy.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "vars": {
    "APP_ORIGIN": "https://t4tmix.com",
    "MAX_TAPE_BYTES": "51200",
    "MAX_MEMO_SECONDS": "20",
    "TAPE_TTL_DAYS": "180"
  },

  "kv_namespaces": [
    // Tape metadata + reply threads. One entry per tape (~5-30 KB serialized).
    { "binding": "TAPES", "id": "REPLACE_WITH_KV_ID_AFTER_wrangler_kv_create" }
  ],

  "r2_buckets": [
    // Voice memo audio blobs (sender-side, per-track) and recipient reply audio.
    // ~10-500 KB each. Cheaper + no per-value cap unlike KV.
    { "binding": "MEMOS", "bucket_name": "t4tmix-memos" }
  ],

  // Cloudflare Email Routing — reply → sender's inbox.
  // Setup:
  //   1. Cloudflare dashboard → your zone → Email → Email Routing → Enable.
  //   2. Add a "Destination address" for each sender email you want to reach
  //      (Cloudflare emails them to verify — one-time per address).
  //   3. Below, list those verified addresses in `allowed_destination_addresses`.
  //   4. The Worker uses this binding as `env.SEND_EMAIL` (see src/index.js
  //      sendReplyEmail).
  //   5. `npm i mimetext` before deploy — the mime library is imported lazily.
  //
  // Note: Cloudflare's send_email binding only sends to verified destinations —
  // this is intentional anti-abuse. Every sender email must be verified once
  // before that person can receive reply notifications.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "allowed_destination_addresses": [
        "demi@queeraccountingsolutions.com"
        // add more verified sender addresses here
      ]
    }
  ]
}
